name: Mantener despierto el bot de Telegram en Render

on:
  schedule:
    # Cada 10 minutos, para no llegar nunca a los 15 min de inactividad de Render
    - cron: '*/10 * * * *'
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Visitar el servicio de Render
        run: |
          curl -sSf https://bot-historico.onrender.com/ || echo "Aviso - el ping ha fallado, puede que Render estuviera reiniciando el servicio"
